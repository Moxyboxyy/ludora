{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludora",
  "version": "../package.json",
  "identifier": "de.ludora.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ludora",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0f1115",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Moxyboxyy",
    "category": "Game",
    "shortDescription": "Ludora - the Client for all Game Clients",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/opt/Ludora/ludora": "linux/opt-ludora.sh"
        }
      }
    }
  }
}
