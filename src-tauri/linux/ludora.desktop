[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Actions=quit;

[Desktop Action quit]
Name=Quit Ludora
Name[de]=Ludora beenden
Exec={{exec}} --quit
