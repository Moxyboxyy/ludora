{
  "name": "ludora",
  "productName": "Ludora",
  "version": "0.7.3",
  "description": "Ludora - the Client for all Game Clients",
  "main": "electron/main.js",
  "author": {
    "name": "Moxyboxyy",
    "email": "MaxiMagDich@hotmail.com"
  },
  "homepage": "https://github.com/Moxyboxyy/ludora",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node --test",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:all": "vite build && electron-builder --win --linux"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "de.ludora.app",
    "productName": "Ludora",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Ludora-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Ludora blendet Launcher-Fenster (Steam, Epic, …) beim Spielstart aus."
      },
      "icon": "build/icon.png",
      "artifactName": "Ludora-${version}-${arch}.${ext}",
      "identity": "-"
    },
    "dmg": {
      "title": "Ludora",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "copyright": "© 2026 Moxyboxyy",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ludora",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Ludora - the Client for all Game Clients",
      "maintainer": "Moxyboxyy <MaxiMagDich@hotmail.com>",
      "artifactName": "Ludora-${version}-${arch}.${ext}",
      "executableName": "ludora"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libappindicator3-1 | libayatana-appindicator3-1"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Moxyboxyy/ludora.git"
  }
}
